-- ==========================================
-- ATMIN Admin Panel
-- Built with Rayfield UI Library
-- ==========================================

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Services & Local Variables
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Create Main Window
local Window = Rayfield:CreateWindow({
   Name = "ATMIN Admin Panel",
   LoadingTitle = "Initializing ATMIN System...",
   LoadingSubtitle = "v1.0 - Next-Gen Admin Interface",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "ATMIN_Configs",
      FileName = "MainConfig"
   },
   Discord = {
      Enabled = false
   },
   KeySystem = false
})

-- Tabs
local CommandTab = Window:CreateTab("Command Bar", 4483362458)
local MovementTab = Window:CreateTab("Movement", 4483362458)
local UtilityTab = Window:CreateTab("Utilities", 4483362458)

-- Welcome Notification
Rayfield:Notify({
   Title = "ATMIN Loaded",
   Content = "System initialized successfully. Welcome, " .. LocalPlayer.DisplayName .. "!",
   Duration = 4,
   Image = 4483362458,
})

--- COMMAND BAR TAB ---
CommandTab:CreateSection("Custom Command Execution")

CommandTab:CreateInput({
   Name = "Command Console",
   PlaceholderText = "Type command (e.g., speed 50, jump 100, reset)...",
   RemoveTextOnFocusLost = false,
   Callback = function(Text)
       local args = string.split(Text, " ")
       local cmd = string.lower(args[1] or "")
       local val = tonumber(args[2])

       if cmd == "speed" and val then
           if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
               LocalPlayer.Character.Humanoid.WalkSpeed = val
               Rayfield:Notify({Title = "ATMIN", Content = "WalkSpeed set to " .. val, Duration = 2})
           end
       elseif cmd == "jump" and val then
           if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
               LocalPlayer.Character.Humanoid.UseJumpPower = true
               LocalPlayer.Character.Humanoid.JumpPower = val
               Rayfield:Notify({Title = "ATMIN", Content = "JumpPower set to " .. val, Duration = 2})
           end
       elseif cmd == "reset" then
           if LocalPlayer.Character then
               LocalPlayer.Character:BreakJoints()
               Rayfield:Notify({Title = "ATMIN", Content = "Character reset.", Duration = 2})
           end
       else
           Rayfield:Notify({Title = "ATMIN Error", Content = "Unknown or invalid command.", Duration = 2})
       end
   end,
})

--- MOVEMENT TAB ---
MovementTab:CreateSection("Locomotion Controls")

MovementTab:CreateSlider({
   Name = "Walk Speed",
   Range = {16, 250},
   Increment = 1,
   Suffix = " studs/sec",
   CurrentValue = 16,
   Flag = "SpeedSlider",
   Callback = function(Value)
       if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
           LocalPlayer.Character.Humanoid.WalkSpeed = Value
       end
   end,
})

MovementTab:CreateSlider({
   Name = "Jump Power",
   Range = {50, 500},
   Increment = 5,
   Suffix = " power",
   CurrentValue = 50,
   Flag = "JumpSlider",
   Callback = function(Value)
       if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
           LocalPlayer.Character.Humanoid.UseJumpPower = true
           LocalPlayer.Character.Humanoid.JumpPower = Value
       end
   end,
})

--- UTILITIES TAB ---
UtilityTab:CreateSection("Character & World Utilities")

UtilityTab:CreateButton({
   Name = "Rejoin Game",
   Callback = function()
       local TeleportService = game:GetService("TeleportService")
       TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
   end,
})

UtilityTab:CreateButton({
   Name = "Copy Player User ID",
   Callback = function()
       setclipboard(tostring(LocalPlayer.UserId))
       Rayfield:Notify({Title = "ATMIN", Content = "User ID copied to clipboard!", Duration = 2})
   end,
})
