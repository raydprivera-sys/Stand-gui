-- Delta Executor Script: Blox Fruits Auto-Gacha & Utility Hub
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Notification function to confirm injection
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Delta Hub Loaded",
    Text = "Blox Fruits Utility Script Active!",
    Duration = 5
})

-- Main UI / Toggle Container
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DeltaHubUI"
ScreenGui.Parent = game.CoreGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 250, 0, 150)
MainFrame.Position = UDim2.new(0.1, 0, 0.1, 0)
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
Title.Text = "Blox Fruits Delta Hub"
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 16
Title.Font = Enum.Font.SourceSansBold
Title.Parent = MainFrame

-- Auto Gacha Button
local GachaButton = Instance.new("TextButton")
GachaButton.Size = UDim2.new(0.9, 0, 0, 40)
GachaButton.Position = UDim2.new(0.05, 0, 0.35, 0)
GachaButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
GachaButton.Text = "Toggle Auto Gacha"
GachaButton.TextColor3 = Color3.fromRGB(255, 255, 255)
GachaButton.TextSize = 14
GachaButton.Font = Enum.Font.SourceSansBold
GachaButton.Parent = MainFrame

local gachaRunning = false
GachaButton.MouseButton1Click:Connect(function()
    gachaRunning = not gachaRunning
    if gachaRunning then
        GachaButton.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
        print("Auto Gacha Started...")
        task.spawn(function()
            while gachaRunning do
                pcall(function()
                    -- Remotes vary based on current Blox Fruits updates
                    local args = { [1] = "Cousin", [2] = "Buy" }
                    ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args))
                end)
                task.wait(120) -- Waits 2 minutes per cousin cooldown
            end
        end)
    else
        GachaButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
        print("Auto Gacha Stopped.")
    end
end)
