-- CLEANUP HANDLER
local function cleanup()
    for _, conn in ipairs(connections) do
        if conn and typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
    end
    connections = {}
    if ScreenGui then ScreenGui:Destroy() end
    getgenv().TSBStandLoaded = nil
    print("[STADO v3.2]: Unloaded and cleaned up.")
end
getgenv().TSBStandCleanup = cleanup

-- UTILITIES
local function findPlayer(query)
    if not query or query == "" then return nil end
    query = string.lower(query)
    for _, player in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(player.Name), query) or string.find(string.lower(player.DisplayName), query) then
            return player
        end
    end
    return nil
end

local function clickM1()
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
    task.wait(0.05)
    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
end

local function pressKey(keyCode, holdTime)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(holdTime or 0.05)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

-- GAROU COMBO EXECUTION
local function executeGarouCombo(target)
    if isAttacking then return end
    
    -- If no target provided in command, attempt to target nearest player
    if not target then
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myHRP then
            local closestDist = math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Name ~= PERMITTED_USER and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local dist = (p.Character.HumanoidRootPart.Position - myHRP.Position).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        target = p
                    end
                end
            end
        end
    end

    if not target then return end
    isAttacking = true

    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local targetHRP = target.Character and target.Character:FindFirstChild("HumanoidRootPart")

    if not myHRP or not targetHRP then 
        isAttacking = false 
        return 
    end

    local function faceTarget()
        if myHRP and targetHRP then
            myHRP.CFrame = CFrame.new(targetHRP.Position + (targetHRP.CFrame.LookVector * -2.5), targetHRP.Position)
        end
    end

    faceTarget()
    task.wait(0.1)

    -- Step 1: 3x M1 Attacks
    for i = 1, 3 do
        faceTarget()
        clickM1()
        task.wait(0.25)
    end

    -- Step 2: Hunter's Grasp (Move 3)
    faceTarget()
    pressKey(Enum.KeyCode.Three, 0.1)
    task.wait(0.8)

    -- Step 3: Lethal Whirlwind Stream (Move 2)
    faceTarget()
    pressKey(Enum.KeyCode.Two, 0.1)
    task.wait(1.2)

    -- Step 4: 2x M1 Attacks
    for i = 1, 2 do
        faceTarget()
        clickM1()
        task.wait(0.25)
    end

    -- Step 5: Prey's Peril (Move 4) Finisher
    faceTarget()
    pressKey(Enum.KeyCode.Four, 0.1)

    task.wait(0.5)
    isAttacking = false
end

-- COMMAND HANDLER
local function processCommand(sender, message)
    if sender.Name ~= PERMITTED_USER then return end
    if string.sub(message, 1, #PREFIX) ~= PREFIX then return end

    local args = string.split(string.sub(message, #PREFIX + 1), " ")
    local cmd = string.lower(args[1] or "")

    if cmd == "summon" then
        isSummoned = true

    elseif cmd == "void" then
        isSummoned = false
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, -500, 0)
        end

    elseif cmd == "ak" then
        local target = findPlayer(args[2])
        task.spawn(function()
            executeGarouCombo(target)
        end)

    elseif cmd == "tp" then
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP then return end

        local destName = string.lower(args[2] or "")
        local pos = LOCATIONS[destName]
        local targetPlayer = findPlayer(args[2])

        if pos then
            myHRP.CFrame = CFrame.new(pos)
        elseif targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            myHRP.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    end
end

-- SMOOTH SIDE-HOVER POSITIONING
local hoverTimer = 0
local followConn = RunService.RenderStepped:Connect(function(dt)
    if not isSummoned or isAttacking then return end
    
    local mainPlayer = Players:FindFirstChild(PERMITTED_USER)
    if mainPlayer and mainPlayer.Character and mainPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local mainHRP = mainPlayer.Character.HumanoidRootPart
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if myHRP then
            hoverTimer = hoverTimer + (dt * 2.5)
            
            local verticalHover = math.sin(hoverTimer) * 0.35
            local targetCFrame = mainHRP.CFrame * CFrame.new(-3.2, verticalHover, 1.5) * CFrame.Angles(0, math.rad(15), 0)
            
            myHRP.CFrame = myHRP.CFrame:Lerp(targetCFrame, 0.25)
        end
    end
end)
table.insert(connections, followConn)

-- CHAT LISTENERS
local function setupChatListener(player)
    if player.Name == PERMITTED_USER then
        local chatConn = player.Chatted:Connect(function(msg)
            processCommand(player, msg)
        end)
        table.insert(connections, chatConn)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupChatListener(player)
end

