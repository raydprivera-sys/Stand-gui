-- STAND POSITIONING & IDLE HOVER ANIMATION
local hoverTimer = 0
local followConn = RunService.RenderStepped:Connect(function(dt)
    if not isSummoned or isAttacking then return end
    
    local mainPlayer = Players:FindFirstChild(PERMITTED_USER)
    if mainPlayer and mainPlayer.Character and mainPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local mainHRP = mainPlayer.Character.HumanoidRootPart
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if myHRP then
            hoverTimer = hoverTimer + (dt * 3)
            local verticalHover = math.sin(hoverTimer) * 0.4 -- Smooth wave motion

            -- Left offset (-2.5), elevated height (1.2 + wave), behind (1.5)
            local relativeOffset = CFrame.new(-2.5, 1.2 + verticalHover, 1.5) * CFrame.Angles(0, math.rad(15), 0)
            local targetCFrame = mainHRP.CFrame * relativeOffset
            
            myHRP.CFrame = myHRP.CFrame:Lerp(targetCFrame, 0.25)
        end
    end
end)
table.insert(connections, followConn)

