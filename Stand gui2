--[ TSB Stand Controller Script - Loadstring Ready ]--

if getgenv().TSBStandLoaded then
    if getgenv().TSBStandCleanup then
        getgenv().TSBStandCleanup()
    end
end

getgenv().TSBStandLoaded = true

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer

-- Configurations (Change "YourUsernameHere" to your main account's username)
local PERMITTED_USER = "lorenzoisthebest1231" 
local PREFIX = "."

-- State Variables
local isSummoned = true
local connections = {}

-- Custom Named Locations
local LOCATIONS = {
    mountain = Vector3.new(150, 250, 300),
    spawn = Vector3.new(0, 5, 0),
}

-- Cleanup function for reloading or unloading safely
local function cleanup()
    for _, conn in ipairs(connections) do
        if conn and typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
    end
    connections = {}
    getgenv().TSBStandLoaded = nil
    print("[Stand]: Script cleaned up and unloaded.")
end
getgenv().TSBStandCleanup = cleanup

-- Helper: Locate Player by Partial Match
local function findPlayer(query)
    if not query or query == "" then return nil end
    query = string.lower(query)
    for _, player in ipairs(Players:GetPlayers()) do
        if string.find(string.lower(player.Name), query) or string.find(string.lower(player.DisplayName), query) then
            return player
        end
    end
    return nil
end

-- Input Simulator for TSB Combat
local function pressKey(keyCode, holdTime)
    VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
    task.wait(holdTime or 0.1)
    VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
end

-- Command Execution Logic
local function processCommand(sender, message)
    if sender.Name ~= PERMITTED_USER then return end
    if string.sub(message, 1, #PREFIX) ~= PREFIX then return end

    local args = string.split(string.sub(message, #PREFIX + 1), " ")
    local cmd = string.lower(args[1] or "")

    if cmd == "summon" then
        isSummoned = true
        print("[Stand]: Active")

    elseif cmd == "void" then
        isSummoned = false
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(0, -500, 0)
        end
        print("[Stand]: Sent to void")

    elseif cmd == "ak" then
        local target = findPlayer(args[2])
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local targetHRP = target.Character.HumanoidRootPart
            
            if myHRP then
                myHRP.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3) * CFrame.Angles(0, math.pi, 0)
                
                task.spawn(function()
                    pressKey(Enum.KeyCode.One, 0.1)
                    task.wait(0.5)
                    pressKey(Enum.KeyCode.Two, 0.1)
                end)
            end
        end

    elseif cmd == "tp" then
        local destName = string.lower(args[2] or "")
        local pos = LOCATIONS[destName]
        local targetPlayer = findPlayer(args[2])

        if pos and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(pos)
        elseif targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = targetPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
        end
    end
end

-- Continuous Follow Logic
local followConn = RunService.RenderStepped:Connect(function()
    if not isSummoned then return end
    
    local mainPlayer = Players:FindFirstChild(PERMITTED_USER)
    if mainPlayer and mainPlayer.Character and mainPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local mainHRP = mainPlayer.Character.HumanoidRootPart
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if myHRP then
            local targetCFrame = mainHRP.CFrame * CFrame.new(2, 1, 3)
            myHRP.CFrame = myHRP.CFrame:Lerp(targetCFrame, 0.2)
        end
    end
end)
table.insert(connections, followConn)

-- Hook Chat Listeners
local function setupChatListener(player)
    if player.Name == PERMITTED_USER then
        local chatConn = player.Chatted:Connect(function(msg)
            processCommand(player, msg)
        end)
        table.insert(connections, chatConn)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupChatListener(player)
end

local playerAddedConn = Players.PlayerAdded:Connect(setupChatListener)
table.insert(connections, playerAddedConn)

print("[Stand]: Script loaded successfully via loadstring!")
