-- Button UI Creator Helper
local function CreateButton(text, globalKey, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, 0, 0, 42)
    Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    Btn.Text = text .. ": [ OFF ]"
    Btn.TextColor3 = Color3.fromRGB(180, 180, 190)
    Btn.Font = Enum.Font.GothamSemibold
    Btn.TextSize = 13
    Btn.Parent = Scroll

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Thickness = 1
    BtnStroke.Color = Color3.fromRGB(45, 45, 60)
    BtnStroke.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        _G[globalKey] = not _G[globalKey]
        if _G[globalKey] then
            Btn.BackgroundColor3 = Color3.fromRGB(0, 160, 100)
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Text = text .. ": [ ON ]"
            BtnStroke.Color = Color3.fromRGB(0, 255, 150)
        else
            Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
            Btn.TextColor3 = Color3.fromRGB(180, 180, 190)
            Btn.Text = text .. ": [ OFF ]"
            BtnStroke.Color = Color3.fromRGB(45, 45, 60)
        end
        task.spawn(function()
            callback(_G[globalKey])
        end)
    end)
end

-- ========================================================
-- FEATURE IMPLEMENTATION LOGIC
-- ========================================================

-- 1. Auto Perfect Cast
CreateButton("Auto Perfect Cast", "Fisch_AutoCast", function(active)
    while _G.Fisch_AutoCast do
        task.wait(0.5)
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("events") and tool.events:FindFirstChild("cast") then
                -- Fires 100% cast force
                tool.events.cast:FireServer(100)
            end
        end
    end
end)

-- 2. Auto Shake (Simulates exact touch/click positions on Mobile UI)
CreateButton("Auto Shake", "Fisch_AutoShake", function(active)
    while _G.Fisch_AutoShake do
        task.wait(0.05)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui then
            local shakeGui = playerGui:FindFirstChild("shakeui")
            if shakeGui and shakeGui:FindFirstChild("safezone") then
                local button = shakeGui.safezone:FindFirstChild("button")
                if button and button.Visible then
                    local posX = button.AbsolutePosition.X + (button.AbsoluteSize.X / 2)
                    local posY = button.AbsolutePosition.Y + (button.AbsoluteSize.Y / 2)
                    
                    VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, true, game, 1)
                    VirtualInputManager:SendMouseButtonEvent(posX, posY, 0, false, game, 1)
                end
            end
        end
    end
end)

-- 3. Insta-Catch / Auto Reel
CreateButton("Insta-Catch / Auto Reel", "Fisch_InstaReel", function(active)
    while _G.Fisch_InstaReel do
        task.wait(0.2)
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if playerGui and playerGui:FindFirstChild("reel") then
            local events = ReplicatedStorage:FindFirstChild("events")
            if events and events:FindFirstChild("reelfinished") then
                -- Fires instant successful reel end event
                events.reelfinished:FireServer(100, true)
            end
        end
    end
end)
