-- CHAT SENDER UTILITY
local function sendChatCommand(messageText)
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local generalChannel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
        if generalChannel then
            generalChannel:SendAsync(messageText)
        end
    else
        local defaultChatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if defaultChatEvents then
            local sayMessage = defaultChatEvents:FindFirstChild("SayMessageRequest")
            if sayMessage then
                sayMessage:FireServer(messageText, "All")
            end
        end
    end
end

-- BUTTON CREATOR HELPER
local function createButton(text, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.88, 0, 0, 30)
    btn.Position = UDim2.new(0.06, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 12
    btn.Parent = MainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = btn

    btn.MouseButton1Click:Connect(callback)
end

-- COMMAND BUTTONS
createButton("Summon Stand", 35, function()
    sendChatCommand(".summon")
end)

createButton("Void Stand", 70, function()
